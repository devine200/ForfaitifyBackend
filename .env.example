DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,0.0.0.0
# INFO in production; DEBUG for more verbose app logs in Railway
LOG_LEVEL=INFO

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (absolute links in emails)
FRONTEND_BASE_URL=http://localhost:5173

# Database — leave empty for local SQLite; Docker Compose sets Postgres DATABASE_URL.
DATABASE_URL=
# SQLITE_PATH=/data/db.sqlite3

# Redis — required for multi-process Channels + Celery.
# Leave empty for local InMemory channel layer + eager/memory Celery.
# Docker Compose sets redis://redis:6379/0
REDIS_URL=
CELERY_TASK_ALWAYS_EAGER=True

# Docker Compose optional bootstrap admin (created on api start if set)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_NAME=Admin
POSTGRES_DB=forfaitify
POSTGRES_USER=forfaitify
POSTGRES_PASSWORD=forfaitify
API_PORT=8000

# Email (console by default; Celery worker sends)
# Set EMAIL_BACKEND=zoho_cpaas to send through the Zoho CPaaS Email API.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ZOHO_CPAAS_API_KEY=
ZOHO_CPAAS_BASE_URL=https://cpaas.zoho.com
DEFAULT_FROM_EMAIL=Forfaitify <noreply@forfaitify.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_RATE_PER_USER_HOUR=10
EMAIL_RATE_PER_USER_DAY=30
EMAIL_SEND_TASK_RATE=30/m
EMAIL_CIRCUIT_FAILURE_THRESHOLD=10
EMAIL_CIRCUIT_COOLDOWN_SECONDS=120

# Supabase Auth (Phase 1). Leave empty to use local stub auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
AUTH_STUB_MODE=True

# Didit. DIDIT_MODE=test uses the sandbox application. DIDIT_MODE=live uses the live one.
# Documents stay on Didit. KYB is merchants, KYC is investors.
# Test workflows should include a Liveness step. In test mode, Didit Approved also
# auto-confirms admin_status so deposit/withdraw unlock without a manual admin click.
DIDIT_MODE=test
DIDIT_API_KEY=
DIDIT_KYB_WORKFLOW_ID=
DIDIT_KYC_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_TEST_API_KEY=
DIDIT_TEST_KYB_WORKFLOW_ID=
DIDIT_TEST_KYC_WORKFLOW_ID=
DIDIT_TEST_WEBHOOK_SECRET=
# Optional sandbox outcome, e.g. approve. Ignored in live mode.
DIDIT_SANDBOX_SCENARIO=approve

# Payments — dummy (demo instant deposit) or flutterwave (checkout + transfers)
PAYMENT_PROCESSOR=dummy
PAYMENT_WEBHOOK_SECRET=
DEFAULT_CURRENCY=NGN
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# DocuSign (Phase 5)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=
DOCUSIGN_WEBHOOK_SECRET=
